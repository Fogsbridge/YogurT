<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fogsbridge.yogurt.server.mapper.FileReferenceMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO file_reference (file_id, target_type, target_id)
        VALUES (#{fileId}, #{targetType}, #{targetId})
    </insert>

    <select id="selectById" resultType="FileReference">
        SELECT *
        FROM file_reference
        WHERE id = #{id}
    </select>
</mapper>