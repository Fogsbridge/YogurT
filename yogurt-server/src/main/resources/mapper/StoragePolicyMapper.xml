<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fogsbridge.yogurt.server.mapper.StoragePolicyMapper">
    <resultMap type="StoragePolicy" id="storagePolicyMap">
        <result column="is_private" property="privateFlag"/>
        <result column="allowed_types" property="allowedTypes"
                typeHandler="com.fogsbridge.yogurt.server.handler.mybatis.JsonTypeHandler"
                javaType="java.util.Set"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO storage_policy (config_id, policy_name, file_type, base_path, is_private, max_size, chunk_size, allowed_types)
        VALUES (#{configId}, #{policyName}, #{fileType}, #{basePath}, #{privateFlag}, #{maxSize}, #{chunkSize},
                #{allowedTypes, typeHandler=com.fogsbridge.yogurt.server.handler.mybatis.JsonTypeHandler})
    </insert>

    <select id="selectById" resultMap="storagePolicyMap">
        SELECT *
        FROM storage_policy
        WHERE id = #{id}
    </select>
</mapper>