{
  "compilerOptions": {
  "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
    "@/*": ["src/*"]
  },
  "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true
},
  "include": ["src/**/*.js", "src/**/*.vue", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}