# ============================================================
# Docker Compose
# ============================================================
MYSQL_DATABASE=yogurt_server
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=mysql123
MYSQL_USER=yogurt
MYSQL_PASSWORD=mysql123

REDIS_PORT=6380
REDIS_REQUIREPASS=redis123

RUSTFS_PORT=9010
RUSTFS_CONSOLE_PORT=9011
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=rustfs123

# ============================================================
# Spring Boot
# ============================================================
SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/yogurt_server?useUnicode=true&characterEncoding=utf8&useSSL=false&connectionTimeZone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=mysql123

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380
SPRING_DATA_REDIS_PASSWORD=redis123
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=5s
